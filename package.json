{
  "name": "keysmash-ipsum",
  "version": "0.0.0",
  "description": "Dummy text from keysmash: seeded random typos (English / mistyped hiragana) restored into sentences by any LLM you plug in",
  "author": "elzup",
  "license": "MIT",
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "keysmash-ipsum": "lib/esm/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "repository": "elzup/keysmash-ipsum",
  "bugs": {
    "url": "https://github.com/elzup/keysmash-ipsum/issues"
  },
  "homepage": "https://github.com/elzup/keysmash-ipsum#readme",
  "keywords": [
    "lorem-ipsum",
    "dummy-text",
    "keysmash",
    "llm",
    "japanese",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf lib",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm build:types",
    "build:cjs": "tsc --module commonjs --declaration false --outDir lib/cjs && echo '{\"type\":\"commonjs\"}' > lib/cjs/package.json",
    "build:esm": "tsc --declaration false --outDir lib/esm",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir lib/types",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.ts\"",
    "cli": "node src/bin.ts",
    "prepublishOnly": "pnpm build && pnpm test",
    "size": "pnpm build && node scripts/size.ts"
  },
  "files": [
    "lib/"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
